
import numpy as np
from astropy.io import fits
import os
from astropy import units as u
from astropy.nddata import CCDData
from ccdproc import Combiner


RAW_FLAT_DIR = '/home/alexia/Desktop/blinov/Capella_data/raw'
MASTER_FLAT_DIR = '/home/alexia/Desktop/blinov/Capella_data/processed'

class Image():
    def __init__(self, fits_path):          #Stores FITS file path and initializes attributes
        self.full_path = fits_path
        self.raw_data  = None
        self.header    = None
        self.flat_g    = None
        self.flat_r    = None
        self.flat_b    = None
        self.exposure  = None

    def read_fits(self):                        #opens fits file and checks if it a flat frame
        print("Reading ", self.full_path)
        with fits.open(self.full_path) as hdul:
            self.header= hdul[0].header

            if self.header['IMAGETYP'] != 'Light Frame' or self.header['OBJECT'] != 'Flat':
                #print(self.header['IMAGETYP'])
                #print(self.header['OBJECT'])
                print(self.full_path, " doesn't seem to be a flat frame")
                exit(0)
                
            self.exposure = self.header['EXPTIME']
            self.raw_data = hdul[0].data / float(self.exposure)


    def write_fits(self, data, fits_path):
        hdu = fits.PrimaryHDU(data)
        hdul = fits.HDUList([hdu])
        hdul.writeto(fits_path)

    def split_channels(self):
        g1 = self.raw_data[::2, 1::2]
        g2 = self.raw_data[1::2, ::2]
        self.data_g = np.add(g1, g2) 
        self.data_b = self.raw_data[::2, ::2]
        self.data_r = self.raw_data[1::2, 1::2]

    def subtract_darks(self,dark_g,dark_r,dark_b):
        print(self.data_g)
        print(dark_g)
        self.data_g = self.data_g - dark_g
        self.data_r = self.data_r - dark_r
        self.data_b = self.data_b - dark_b

    def create_CCDdata(self):
        self.ccd_g = CCDData(self.data_g, unit=u.adu)
        self.ccd_b = CCDData(self.data_b, unit=u.adu)
        self.ccd_r = CCDData(self.data_r, unit=u.adu)


def get_filenames():
    
    flats_to_proc = []
    days_raw    = os.listdir(RAW_FLAT_DIR)
    days_master = os.listdir(MASTER_FLAT_DIR)
    for day in days_raw:
        #if day not in days_master:
        files = list( filter(lambda x: x.startswith("Flat") and x.endswith(".fit"), os.listdir(os.path.join(RAW_FLAT_DIR, day) ) ) )
        flats_files = list( map(lambda x: os.path.join(RAW_FLAT_DIR, day, x), files) )
        flats_to_proc.append([day, flats_files])
    return flats_to_proc

if __name__ == "__main__":
    flats_to_proc = get_filenames()
    #print(flats_to_proc)
    for flat_info in flats_to_proc:
        day, flats_files = flat_info
        print(day)
        images_g = []
        images_b = []
        images_r = []
        DARK_FOLDER = os.path.join(MASTER_FLAT_DIR, day)
        for flat_file in flats_files:
            img = Image(flat_file)
            img.read_fits()
            img.split_channels()
            with fits.open(os.path.join(DARK_FOLDER, 'Dark_g.fits')) as hdul_g:
            	dark_g = hdul_g[0].data
            with fits.open(os.path.join(DARK_FOLDER, 'Dark_b.fits')) as hdul_b:
            	dark_b = hdul_b[0].data
            with fits.open(os.path.join(DARK_FOLDER, 'Dark_r.fits')) as hdul_r:
            	dark_r = hdul_r[0].data

            img.subtract_darks(dark_g, dark_r, dark_b)
            img.create_CCDdata()
            images_g.append(img.ccd_g)
            images_b.append(img.ccd_b)
            images_r.append(img.ccd_r)

        if len(images_g) > 0 and len(images_b) > 0 and len(images_r) > 0:
            combiner_g = Combiner(images_g)
            combiner_b = Combiner(images_b)
            combiner_r = Combiner(images_r)

            combined_median_g = combiner_g.median_combine()
            combined_median_b = combiner_b.median_combine()
            combined_median_r = combiner_r.median_combine()

            OUT_FOLDER = os.path.join(MASTER_FLAT_DIR, day)
            if not os.path.exists(OUT_FOLDER):
                os.makedirs(OUT_FOLDER)

            combined_median_g.write(os.path.join(OUT_FOLDER, 'Flat_g.fits'))
            combined_median_b.write(os.path.join(OUT_FOLDER, 'Flat_b.fits'))
            combined_median_r.write(os.path.join(OUT_FOLDER, 'Flat_r.fits'))
